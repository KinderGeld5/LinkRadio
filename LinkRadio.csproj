<Project Sdk="Microsoft.NET.Sdk">

  <!--
    LinkRadio - BepInEx 5 plugin for Nomad Drive.
    Referenz-DLLs (Spiel + BepInEx) werden NICHT mitgeliefert: bitte nach libs\ kopieren, siehe libs\README.txt
    Bauen:  dotnet build -c Release     ->  bin\Release\net472\LinkRadio.dll
    (Hinweis: Dieses csproj wurde nicht mit dem dotnet-SDK getestet; die getestete Build-Variante ist build.sh mit mcs.)
  -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>LinkRadio</AssemblyName>
    <RootNamespace>LinkRadio</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);618;612;168;219</NoWarn>
    <LibsDir Condition="'$(LibsDir)' == ''">$(MSBuildThisFileDirectory)libs\</LibsDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference Assemblies fuer net472 (noetig z.B. unter Linux / ohne Targeting Pack) -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>$(LibsDir)BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Mirror"><HintPath>$(LibsDir)Mirror.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(LibsDir)UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(LibsDir)UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(LibsDir)UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AudioModule"><HintPath>$(LibsDir)UnityEngine.AudioModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UnityWebRequestModule"><HintPath>$(LibsDir)UnityEngine.UnityWebRequestModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UnityWebRequestAudioModule"><HintPath>$(LibsDir)UnityEngine.UnityWebRequestAudioModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(LibsDir)UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(LibsDir)UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.InputSystem"><HintPath>$(LibsDir)Unity.InputSystem.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

</Project>
